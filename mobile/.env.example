# Copy to .env (Expo inlines EXPO_PUBLIC_* values at build time; none of these are secrets).

# The Verso web app: serves the AI, Song Rooms, family plan and store webhook APIs.
EXPO_PUBLIC_API_URL=https://your-verso-site.example

# Same Supabase project as the web app (Project URL and anon public key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (App Store and Google Play subscriptions).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
