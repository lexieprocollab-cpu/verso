# Copy to .env.local and fill in. Never commit real keys.

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic console → API keys (server-only, never exposed to the browser)
ANTHROPIC_API_KEY=

# Server-only Supabase key for payments and analytics writes (Settings → API → service_role). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys; Products → the monthly price; Webhooks → signing secret)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional: offer yearly and family plans too.
STRIPE_PRICE_ID_YEARLY=
STRIPE_PRICE_ID_FAMILY=
STRIPE_WEBHOOK_SECRET=

# Any long random string; open the dashboard at /stats?key=<STATS_KEY>
STATS_KEY=

# Mobile app subscriptions (App Store / Google Play via RevenueCat): the webhook's Authorization secret.
REVENUECAT_WEBHOOK_SECRET=
